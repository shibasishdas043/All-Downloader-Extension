{
  "name": "all-downloader-extension",
  "version": "1.0.0",
  "description": "A secure, open-source browser download manager extension",
  "type": "module",
  "scripts": {
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write src/**/*.js src/**/*.css src/**/*.html",
    "test": "jest",
    "test:watch": "jest --watch",
    "build": "node scripts/build.js",
    "pack": "node scripts/build.js && cd dist && zip -r ../all-downloader.zip ."
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.2.5"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {},
    "testMatch": ["**/tests/**/*.test.js"],
    "moduleNameMapper": {
      "^../shared/(.*)$": "<rootDir>/src/shared/$1"
    }
  },
  "keywords": ["browser-extension", "download-manager", "chrome-extension", "open-source"],
  "license": "MIT"
}
