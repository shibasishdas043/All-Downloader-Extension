# ============================================================
#  All-Downloader Extension — .gitignore
# ============================================================

# ── Node / npm ───────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml
.npm/
.pnp/
.pnp.js

# ── Build output & caches ─────────────────────────────────────
dist/
build/
.vite/
.vitest/

# ── Compiled JS safeguards (sources in src/ are TypeScript) ────
src/**/*.js
src/**/*.js.map
src/**/*.d.ts

# ── Extension packaging output ───────────────────────────────
*.zip
*.crx
*.xpi
*.tar.gz
*.tgz

# ── Test downloads & user artifacts ──────────────────────────
downloads/
test-downloads/
*.iso
*.img
*.bin
*.part
*.download

# ── Test coverage & reports ──────────────────────────────────
coverage/
.nyc_output/
*.lcov
test-results/
junit.xml

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── Environment & secrets ────────────────────────────────────
.env
.env.*
.env*.local
*.local
!.env.example
*.pem
*.key
*.p12
*.pfx
*.cert

# ── AI Agents & IDE Cache ────────────────────────────────────
.agents/
.gemini/
.cursor/
.claude/
.windsurf/
.antigravity/

# ── OS generated files ───────────────────────────────────────
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon?
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
# Linux
*~
.directory

# ── IDE / Editor configs ─────────────────────────────────────
# VS Code (keep extensions.json for recommended extensions)
.vscode/*
!.vscode/extensions.json
*.code-workspace
# JetBrains (WebStorm, IntelliJ, Rider)
.idea/
*.iml
*.iws
*.ipr
# Vim / Neovim
*.swp
*.swo
.session.vim
# Sublime Text
*.sublime-project
*.sublime-workspace
# Emacs
\#*\#
.emacs.desktop
.emacs.desktop.lock
# Atom
.atom/

# ── Linter / formatter caches ────────────────────────────────
.eslintcache
.prettiercache
.stylelintcache

# ── TypeScript build info (if ever added) ────────────────────
*.tsbuildinfo

# ── Temporary / scratch files ────────────────────────────────
tmp/
temp/
scratch/
out/
*.tmp
*.bak
*.orig
*.rej

# ── Platform-specific tooling scripts ────────────────────────
# Contributors can use Photoshop, GIMP, Figma, or any imaging
# tool they prefer — these scripts are machine-specific helpers.
scripts/*.ps1
scripts/*.sh
scripts/*.bat
scripts/*.cmd
scripts/*.exe

# ── Large / raw design source files ──────────────────────────
# Raw AI-generated images and design sources — not needed in repo.
# Only the final optimised icon PNG files belong here.
src/assets/icons/Firefly_*.png
src/assets/icons/*.psd
src/assets/icons/*.ai
src/assets/icons/*.fig
src/assets/icons/*.sketch
src/assets/icons/*.xcf
src/assets/*.psd
src/assets/*.ai

# ── Browser extension debug artifacts ────────────────────────
# Chrome loads these at runtime — never commit them
chrome-profile/
.chrome-debug/
firefox-profile/
web-ext-artifacts/